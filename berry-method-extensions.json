{
    "extensions": [
        {
            "namespace": "Berry\\Html",
            "class": [
                "HtmlTag",
                "HtmlVoidTag"
            ],
            "uses": [
                "Berry\\Htmx\\HxSwap",
                "Berry\\Htmx\\HxTarget"
            ],
            "methods": [
                {
                    "name": "hxGet",
                    "doc": "Issues a GET request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxPost",
                    "doc": "Issues a POST request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxPut",
                    "doc": "Issues a PUT request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxPatch",
                    "doc": "Issues a PATCH request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxDelete",
                    "doc": "Issues a DELETE request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxQuery",
                    "doc": "Issues a QUERY request to the specified URL",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "url"
                        }
                    ]
                },
                {
                    "name": "hxAction",
                    "doc": "Request URL, paired with hxMethod",
                    "returns": "static",
                    "args": [
                        { "type": "string", "name": "string" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxMethod",
                    "doc": "HTTP method, paired with hxAction",
                    "returns": "static",
                    "args": [
                        { "type": "string", "name": "string" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxConfig",
                    "doc": "Request configuration as HCON or JSON",
                    "returns": "static",
                    "args": [
                        { "type": "string", "name": "string" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxStatus",
                    "doc": "Response overrides for a status code or pattern such as 4xx",
                    "returns": "static",
                    "args": [
                        { "type": "int|string", "name": "code" },
                        { "type": "string", "name": "config" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxIgnore",
                    "doc": "Disables htmx processing on this element and its descendants",
                    "returns": "static",
                    "args": []
                },
                {
                    "name": "hxMorphSkip",
                    "doc": "Leaves an element and its children untouched during morph swaps",
                    "returns": "static",
                    "args": []
                },
                {
                    "name": "hxMorphSkipChildren",
                    "doc": "Morphs attributes but leaves children untouched",
                    "returns": "static",
                    "args": []
                },
                {
                    "name": "hxBoost",
                    "doc": "Enables progressive enhancement (boolean or HCON options)",
                    "returns": "static",
                    "args": [
                        { "type": "bool|string", "name": "value" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxPreload",
                    "doc": "Prefetch trigger; requires the preload extension",
                    "returns": "static",
                    "args": [
                        { "type": "string", "name": "string" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxPending",
                    "doc": "Pending content selector; requires the hx-pending extension",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxConfirm",
                    "doc": "Shows a confirm() dialog before issuing requests",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxDisable",
                    "doc": "Disables selected elements while a request is in flight; use hxIgnore to disable processing",
                    "returns": "static",
                    "args": [
                        { "type": "string", "name": "selector" },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxEncoding",
                    "doc": "Changes encoding to multipart/form-data (\"multipart/form-data\")",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxExt",
                    "doc": "Deprecated: Load extension scripts directly instead. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxHistory",
                    "doc": "Deprecated: History restoration refetches pages; remove this attribute. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "bool",
                            "name": "value"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxInclude",
                    "doc": "Additional elements to include in requests",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxIndicator",
                    "doc": "CSS selector for indicator element",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxParams",
                    "doc": "Deprecated: Filter parameters in the htmx:config:request event instead. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxPreserve",
                    "doc": "Preserves element across swaps",
                    "returns": "static",
                    "args": []
                },
                {
                    "name": "hxPrompt",
                    "doc": "Shows a prompt() before requests; requires the hx-prompt extension",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxPushUrl",
                    "doc": "Pushes URL into history (\"true\" for current, \"false\" to disable)",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string|bool",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxReplaceUrl",
                    "doc": "Replaces current URL without push",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string|bool",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxRequest",
                    "doc": "Deprecated: Use hxConfig instead. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxSelect",
                    "doc": "Selects content from response to swap",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxSelectOob",
                    "doc": "Out-of-band swaps (comma-separated)",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxSwapOob",
                    "doc": "Marks element for out-of-band swap",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string|bool",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxSync",
                    "doc": "Synchronizes requests on this element",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxTarget",
                    "doc": "Target element for response",
                    "returns": "static",
                    "args": [
                        {
                            "type": "HxTarget|string",
                            "name": "val"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxTrigger",
                    "doc": "Specifies trigger events",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxValidate",
                    "doc": "Validates before request (\"true\")",
                    "returns": "static",
                    "args": [
                        {
                            "type": "bool",
                            "name": "value"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxVals",
                    "doc": "Adds extra values to requests (HCON or JSON)",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxHeaders",
                    "doc": "Adds extra headers (HCON or JSON)",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxSwap",
                    "doc": "Swap strategy for response",
                    "returns": "static",
                    "args": [
                        {
                            "type": "HxSwap|string",
                            "name": "val"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxDisinherit",
                    "doc": "Deprecated: Inheritance is explicit; local attributes override inherited values. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxInherit",
                    "doc": "Deprecated: Pass inherited: true to individual helpers instead. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxHistoryElt",
                    "doc": "Marks the history restoration target",
                    "returns": "static",
                    "args": []
                },
                {
                    "name": "hxDisabledElt",
                    "doc": "Deprecated: Use hxDisable instead. Will be removed with 0.6.",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "string"
                        },
                        { "type": "bool", "name": "inherited", "defaultValue": "false" },
                        { "type": "bool", "name": "append", "defaultValue": "false" }
                    ]
                },
                {
                    "name": "hxOn",
                    "doc": "Inline event handler; omit js for extended hx-on syntax",
                    "returns": "static",
                    "args": [
                        {
                            "type": "string",
                            "name": "event"
                        },
                        {
                            "type": "?string",
                            "name": "js",
                            "defaultValue": "null"
                        }
                    ]
                }
            ]
        }
    ]
}
